{
  "name": "@rad-orchestration/telemetry",
  "version": "1.0.0-alpha.14",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./read/effective-tokens": {
      "types": "./dist/read/effective-tokens.d.ts",
      "import": "./dist/read/effective-tokens.js",
      "default": "./dist/read/effective-tokens.js"
    },
    "./read/pricing": {
      "types": "./dist/read/pricing.d.ts",
      "import": "./dist/read/pricing.js",
      "default": "./dist/read/pricing.js"
    }
  },
  "description": "Dependency-free harness-neutral telemetry capture engine",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
