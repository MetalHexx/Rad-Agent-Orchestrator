{
  "name": "@rad-orchestration/graph-service",
  "version": "1.0.0-alpha.13",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "description": "In-process composition host for the steerable DAG graph engine — the DB owner, the engine/store/registry wiring, and the HTTP surface later tasks build routes onto",
  "bin": {
    "radorch-graph-service": "./dist/bin/serve.js",
    "radorch-graph-service-ensure": "./dist/bin/ensure.js",
    "radorch-graph-service-status": "./dist/bin/status.js",
    "radorch-graph-service-stop": "./dist/bin/stop.js",
    "radorch-graph-service-seed": "./dist/bin/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ensure": "node dist/bin/ensure.js",
    "status": "node dist/bin/status.js",
    "stop": "node dist/bin/stop.js",
    "seed": "node dist/bin/seed.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@rad-orchestration/graph-engine": "1.0.0-alpha.13",
    "@rad-orchestration/graph-store-sqlite": "1.0.0-alpha.13",
    "hono": "^4.12.28",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@rad-orchestration/graph-client": "1.0.0-alpha.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.17",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
