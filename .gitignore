node_modules/
package-lock.json
# cli keeps a committed lockfile for dependency repeatability
!cli/package-lock.json
# Engine needs a committed lockfile for dependency repeatability
!greenfield/harness-adapters/engine/package-lock.json

.vscode/mcp.json

.vscode/settings.json

# User-owned Claude Code settings — never committed. Personal hooks, settings
# overrides, and scheduled-task locks go here; the dogfood build no longer writes
# under .claude/ at the repo root (it deploys to ~/.claude/ via the installer's
# manifest-driven library — see scripts/build.js).
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Adapter staging hopper + dogfood prior-manifest cache + esbuild scratch.
# scripts/build.js writes dist/staging/<harness>/ (transformed adapter output)
# and dist/dogfood-prior-<harness>.json (prior-manifest snapshot used to clean
# up renamed/deleted rad files on the next build). Never committed.
/dist/

# Workspace library build output — produced by the build pipeline, never committed.
lib/*/dist/

# Reference example package build output — same convention as lib/*/dist/: built via its own
# `tsc` script, never hand-committed. graph-service's tests build it before running (see
# graph-service/AGENTS.md).
examples/*/dist/

# esbuild bundle output — produced by `npm run bundle` in cli/
dist-bundle/

# Ephemeral installer test directory — created by rad-test-release prompt, never committed
test-installer/

*.code-workspace

# Ephemeral test log artifacts — never commit
*-tests.log
test-run.log

# Prompt harness — run outputs ignored by default.
# NOTE: git ignore cannot re-include files if an ancestor directory is excluded
# by a directory-matching pattern. The rules below ignore run-folder CONTENTS
# (files at least two levels under output/) while leaving the fixture-specific
# directory (`output/<fixture>/`) un-ignored, so `!` exceptions below can
# re-include specific files under otherwise-ignored run folders.
/prompt-tests/extra-high-pipeline-e2e/output/*/*/**
!/prompt-tests/extra-high-pipeline-e2e/output/*/.gitkeep
!/prompt-tests/extra-high-pipeline-e2e/output/rainbow-hello/baseline-*/lint-report.md
!/prompt-tests/extra-high-pipeline-e2e/output/rainbow-hello/baseline-*/run-notes.md
!/prompt-tests/extra-high-pipeline-e2e/output/rainbow-hello/baseline-rainbow-hello-2026-05-01/lint-report.md
!/prompt-tests/extra-high-pipeline-e2e/output/rainbow-hello/baseline-rainbow-hello-2026-05-01/run-notes.md

# Prompt harness — corrective-mediation-e2e.
# Same structure as plan-pipeline-e2e: ignore run-folder contents, re-include
# the inaugural-baseline run-notes.md under baseline-* folders.
/prompt-tests/corrective-mediation-e2e/output/*/*/**
!/prompt-tests/corrective-mediation-e2e/output/*/.gitkeep
!/prompt-tests/corrective-mediation-e2e/output/broken-colors/baseline-*/run-notes.md

# Prompt harness — phase-review-mediation-e2e.
# Same structure as above: ignore run-folder contents, re-include the
# inaugural-baseline run-notes.md under baseline-* folders.
/prompt-tests/phase-review-mediation-e2e/output/*/*/**
!/prompt-tests/phase-review-mediation-e2e/output/*/.gitkeep
!/prompt-tests/phase-review-mediation-e2e/output/colors-greet-mismatch/baseline-*/run-notes.md

# Prompt harness — code-review-rework-e2e (iter-12).
# Same structure as above: ignore run-folder contents, re-include the
# inaugural-baseline run-notes.md under baseline-* folders.
/prompt-tests/code-review-rework-e2e/output/*/*/**
!/prompt-tests/code-review-rework-e2e/output/*/.gitkeep
!/prompt-tests/code-review-rework-e2e/output/conformance-tiered/baseline-*/run-notes.md

# Prompt harness — execute-coding-task-e2e (iter-13).
# Same structure as above: ignore run-folder contents, re-include the
# inaugural-baseline run-notes.md + lint-report.md under baseline-* folders.
/prompt-tests/execute-coding-task-e2e/output/*/*/**
!/prompt-tests/execute-coding-task-e2e/output/*/.gitkeep
!/prompt-tests/execute-coding-task-e2e/output/tdd-slip/baseline-*/lint-report.md
!/prompt-tests/execute-coding-task-e2e/output/tdd-slip/baseline-*/run-notes.md

# Prompt harness — coder-commit-e2e.
# Same structure as above: ignore run-folder contents (including the nested
# sandbox .git/), re-include the inaugural-baseline run-notes.md under baseline-* folders.
# Two modes share this behavior: solo-commit (isolated) + pipeline-sideproject (real pipeline).
/prompt-tests/coder-commit-e2e/output/*/*/**
!/prompt-tests/coder-commit-e2e/output/*/.gitkeep
!/prompt-tests/coder-commit-e2e/output/solo-commit/baseline-*/run-notes.md
!/prompt-tests/coder-commit-e2e/output/pipeline-sideproject/baseline-*/run-notes.md

# Prompt harness — repo-skill-discovery-e2e.
/prompt-tests/repo-skill-discovery-e2e/output/*/*/**
!/prompt-tests/repo-skill-discovery-e2e/output/*/.gitkeep
!/prompt-tests/repo-skill-discovery-e2e/output/skill-disco-fixture/baseline-*/lint-report.md
!/prompt-tests/repo-skill-discovery-e2e/output/skill-disco-fixture/baseline-*/run-notes.md

# Prompt harness — instructions-reach-e2e.
# Same structure as above: ignore run-folder contents, re-include the
# inaugural-baseline lint-report.md + run-notes.md under baseline-* folders.
/prompt-tests/instructions-reach-e2e/output/*/*/**
!/prompt-tests/instructions-reach-e2e/output/*/.gitkeep
!/prompt-tests/instructions-reach-e2e/output/instructions-canary/baseline-*/lint-report.md
!/prompt-tests/instructions-reach-e2e/output/instructions-canary/baseline-*/run-notes.md

# Prompt harness — low-pipeline-e2e.
# Same structure as extra-high-pipeline-e2e: ignore run-folder contents, re-include
# the inaugural-baseline lint-report.md + run-notes.md under baseline-* folders.
/prompt-tests/low-pipeline-e2e/output/*/*/**
!/prompt-tests/low-pipeline-e2e/output/*/.gitkeep
!/prompt-tests/low-pipeline-e2e/output/rainbow-hello-quick/baseline-*/lint-report.md
!/prompt-tests/low-pipeline-e2e/output/rainbow-hello-quick/baseline-*/run-notes.md

# Prompt harness — rad-plan-benchmark.
# INVERTED pattern vs the other behaviors: this is an artifact-comparison harness, so the
# full planning output under each versioned run-N/ folder IS committed (Requirements,
# Master Plan, exploded phases/tasks, brainstorming copy) for cross-run diffing. Only pure
# runtime churn is ignored — it adds per-machine/per-run diff noise and isn't an authored
# artifact.
/prompt-tests/rad-plan-benchmark/output/run-*/*/state.json
/prompt-tests/rad-plan-benchmark/output/run-*/*/template.yml
/prompt-tests/rad-plan-benchmark/output/run-*/*/backups/

# Prompt harness — rad-master-plan-benchmark-v1 / -v2 (master-doc creation step).
# Same INVERTED pattern as rad-plan-benchmark: the full planning output under each
# versioned run-N/ folder IS committed (Requirements, Master Plan, audit report, exploded
# phases/tasks) for cross-run and cross-version (V1 old-ledger vs V2 new-format) diffing.
# Only pure runtime churn is ignored.
/prompt-tests/rad-master-plan-benchmark-v1/output/run-*/*/state.json
/prompt-tests/rad-master-plan-benchmark-v1/output/run-*/*/template.yml
/prompt-tests/rad-master-plan-benchmark-v1/output/run-*/*/backups/
/prompt-tests/rad-master-plan-benchmark-v2/output/run-*/*/state.json
/prompt-tests/rad-master-plan-benchmark-v2/output/run-*/*/template.yml
/prompt-tests/rad-master-plan-benchmark-v2/output/run-*/*/backups/

# handoff A/B benchmark — ignore all per-run output, keep the folder placeholder.
# The pristine sandbox (_handoff-sandbox/) is a committed fixture, NOT ignored.
/prompt-tests/handoff-original-e2e/output/run-*/
!/prompt-tests/handoff-original-e2e/output/.gitkeep
/prompt-tests/handoff-improved-e2e/output/run-*/
!/prompt-tests/handoff-improved-e2e/output/.gitkeep

# plan-to-code A/B benchmark (final leg — coder executes the frozen planner-generated task under a
# pinned coder-skill version). Same shape as the handoff arms: ignore all per-run output, keep the
# folder placeholder. Fixtures (frozen handoff + pinned skill) ARE committed.
/prompt-tests/plan-to-code-original-e2e/output/run-*/
!/prompt-tests/plan-to-code-original-e2e/output/.gitkeep
/prompt-tests/plan-to-code-improved-e2e/output/run-*/
!/prompt-tests/plan-to-code-improved-e2e/output/.gitkeep

# Prompt harness — masterplan A/B benchmark (planner-skill A/B on the /engine-graph task).
# INVERTED pattern like rad-master-plan-benchmark: the small planning artifacts (Requirements,
# Master Plan, exploded phases/tasks) under each run-*/ ARE committed for cross-arm / cross-run
# diffing. The per-run sandbox copy (workspace/) and runtime churn (state.json/template.yml/backups)
# are ignored — workspace/ is just a throwaway copy of the committed _handoff-sandbox fixture.
/prompt-tests/masterplan-original-e2e/output/run-*/workspace/
/prompt-tests/masterplan-original-e2e/output/run-*/*/state.json
/prompt-tests/masterplan-original-e2e/output/run-*/*/template.yml
/prompt-tests/masterplan-original-e2e/output/run-*/*/backups/
!/prompt-tests/masterplan-original-e2e/output/.gitkeep
/prompt-tests/masterplan-improved-e2e/output/run-*/workspace/
/prompt-tests/masterplan-improved-e2e/output/run-*/*/state.json
/prompt-tests/masterplan-improved-e2e/output/run-*/*/template.yml
/prompt-tests/masterplan-improved-e2e/output/run-*/*/backups/
!/prompt-tests/masterplan-improved-e2e/output/.gitkeep

# Plugin artifacts
# NOTE: .claude/ (above) is the gitignored dogfood build output;
# .claude-plugin/ is the COMMITTED Claude marketplace manifest folder
# (under harness-installers/claude-plugin/.claude-plugin/).
# The plugin staging tree (cli/dist/marketplaces/) is fully gitignored.
cli/dist/marketplaces/

# Next.js build output (root-level)
/.next/
docs/internals/_private/_done

# orchestration harness commit-arg artifact (machine-local)
.commit-repos.js