{
  "name": "@rad-orchestration/graph-engine",
  "version": "1.0.0-alpha.9",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/state-store-conformance.d.ts",
      "import": "./dist/testing/state-store-conformance.js",
      "default": "./dist/testing/state-store-conformance.js"
    }
  },
  "description": "Steerable DAG execution engine",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
